{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    /* Kademeli geçiş: .js dosyaları hâlâ derleniyor ama tip kontrolüne
       sokulmuyorlar. Bir dosya .ts/.tsx olduğunda tam kontrol devreye giriyor. */
    "allowJs": true,
    "checkJs": false,

    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    /* "node": i18n.test.ts çeviri dosyalarını fs ile okuyor. Bu tipler eskiden
       transitif bir bağımlılıktan geliyordu; bağımlılık ağacı değişince kayboldu.
       Artık @types/node açık bir devDependency ve burada da açıkça isteniyor. */
    "types": ["vite/client", "vitest/globals", "node"]
  },
  "include": ["src", "vite.config.js", "vitest.config.js"],
  "exclude": ["node_modules", "dist", "coverage", "cypress"]
}
